rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().keys().hasAll(['name', 'status', 'createdAt']) && incoming().name is string;
      allow update: if isSignedIn() && incoming().keys().hasAny(['name', 'email', 'phone', 'company', 'sector', 'status', 'updatedAt']);
      allow delete: if isSignedIn();

      match /interactions/{interactionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().keys().hasAll(['clientId', 'type', 'date', 'createdAt']);
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().keys().hasAll(['title', 'clientId', 'status', 'createdAt']);
      allow update: if isSignedIn() && incoming().keys().hasAny(['title', 'clientId', 'value', 'status', 'deadline', 'items', 'updatedAt']);
      allow delete: if isSignedIn();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().keys().hasAll(['title', 'clientId', 'type', 'status', 'createdAt']) && incoming().title is string;
      allow update: if isSignedIn() && incoming().keys().hasAny(['title', 'clientId', 'type', 'status', 'amount', 'notes', 'updatedAt']);
      allow delete: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().keys().hasAll(['title', 'date', 'status', 'priority', 'createdAt']);
      allow update: if isSignedIn() && incoming().keys().hasAny(['title', 'description', 'date', 'status', 'priority', 'completedBy']);
      allow delete: if isSignedIn();
    }
  }
}
