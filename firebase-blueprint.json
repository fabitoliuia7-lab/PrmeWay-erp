{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users (Primeway staff)",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Client": {
      "title": "Client",
      "description": "Primeway Invest & Logística clients",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "sector": { "type": "string" },
        "status": { "type": "string", "enum": ["Novo", "Em Contato", "Qualificado", "Perdido", "Ganho", "Ativo", "Inativo"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "status"]
    },
    "Interaction": {
      "title": "Client Interaction",
      "description": "History of interactions with a client",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Ligação", "E-mail", "Reunião", "WhatsApp"] },
        "notes": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "type", "date"]
    },
    "Opportunity": {
      "title": "Sales Opportunity",
      "description": "Sales pipelines and generated budgets",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "clientId": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string", "enum": ["Prospecção", "Proposta", "Negociação", "Ganho", "Perdido"] },
        "deadline": { "type": "string", "format": "date" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "price": { "type": "number" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "clientId", "status"]
    },
    "Sale": {
      "title": "Sale / Importation",
      "description": "Sales and importation tracking",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["Importação Completa", "Importação Assistida", "Transporte Regional", "Consultoria"] },
        "status": { "type": "string", "enum": ["Pending", "Negotiating", "Purchased", "In Transit", "Customs", "Delivered", "Cancelled"] },
        "amount": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "clientId", "type", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Staff and admins of Primeway"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Client records"
    },
    "/clients/{clientId}/interactions/{interactionId}": {
      "schema": { "$ref": "#/entities/Interaction" },
      "description": "Client interactions"
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "Sales opportunities and budgets"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Sales and service records"
    }
  }
}
